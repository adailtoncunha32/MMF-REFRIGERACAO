# Copie este ficheiro para ".env" e preencha as chaves.
# O ficheiro .env nunca deve ser partilhado nem enviado para repositórios.

# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Chave da Tavily (https://app.tavily.com)
TAVILY_API_KEY=

# Primeiro administrador (criado automaticamente quando a base de dados não tem utilizadores).
# Não existe registo público: sem estes valores ninguém consegue criar contas.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: modelo da Anthropic a utilizar (por omissão: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Opcional: base de dados. Por omissão é criado o ficheiro data/tecnicos_avac.db (SQLite).
# Exemplo para PostgreSQL (requer: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://utilizador:palavra-passe@servidor:5432/tecnicos_avac
